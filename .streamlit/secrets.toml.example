# Modèle de secrets Streamlit — MonPortefeuille 2
#
# Copiez ce fichier en `.streamlit/secrets.toml` et renseignez vos valeurs.
# NE COMMITEZ JAMAIS `.streamlit/secrets.toml` — il est dans .gitignore.
#
# RAPPEL SÉCURITÉ : la v1 commitait l'URL et la clé Supabase en dur dans
# take_snapshot.py et calc_perf.py, sur un repo public. Révoquez cette ancienne
# clé publishable dans Supabase (Settings > API) avant de déployer la v2.

SUPABASE_URL = "https://VOTRE-PROJET.supabase.co"
SUPABASE_KEY = "VOTRE-CLE-PUBLISHABLE"

# Même service IA que l'application Android.
# Cette clé autorise seulement la discussion — jamais l'administration.
UDE_URL = "https://universite-epargne.VOTRE-SOUS-DOMAINE.workers.dev"
UDE_CLE_SERVICE = "VOTRE_CLE_SERVICE"

# Optionnel : mot de passe d'accès à l'application.
# Laissez vide pour un accès libre (déconseillé si l'app est publique).
# APP_PASSWORD = ""
