+def flux_instruments_final_usd(ctx: "Contexte") -> float:
+    """Achats et ventes de titres à imputer à la dernière période.
+
+    Payer des titres avec des liquidités ne change pas la richesse : c'est un
+    transfert du périmètre « courant » vers le périmètre « investi ». Compté
+    comme un gain de marché, il gonfle la performance du montant de l'opération
+    — l'artefact constaté le 07/10/2026 (68 FLXC.L, 1 943,91 $, saisis après le
+    snapshot du soir : +2,85 % affichés au lieu de -0,38 %).
+
+    Le test décisif n'est pas la date de l'opération mais son ENREGISTREMENT :
+    une opération saisie après le snapshot ne peut pas y figurer, même si elle
+    porte la même date. L'horodatage `cree_le` le dit exactement ; à défaut
+    (lignes importées de la v1), on retient les opérations postérieures à la
+    date de la référence — jamais celles du même jour, pour ne pas compter deux
+    fois un achat déjà présent dans le snapshot.
+
+    Retourne un montant signé en dollars : un achat est positif (il entre dans
+    le périmètre investi), une vente négative.
+    """
+    transactions = getattr(ctx, "transactions", None) or []
+    snaps = getattr(ctx, "snapshots", None)
+    if not transactions or snaps is None or getattr(snaps, "empty", True):
+        return 0.0
+    if "Date" not in getattr(snaps, "columns", []):
+        return 0.0
+
+    reference = snaps[~snaps["_live"].eq(True)] if "_live" in snaps.columns else snaps
+    if reference is None or reference.empty:
+        return 0.0
+    dates_ref = _parser_dates(reference["Date"]).dropna()
+    if dates_ref.empty:
+        return 0.0
+    derniere = dates_ref.max().date()
+    dernieres = reference.loc[dates_ref == dates_ref.max()]
+    cree_ref = None
+    if "cree_le" in dernieres.columns and not dernieres.empty:
+        brut = dernieres.iloc[-1].get("cree_le")
+        if pd.notna(brut):
+            cree_ref = pd.to_datetime(brut, errors="coerce", utc=True)
+
+    total = 0.0
+    for t in transactions:
+        montant = abs(float(getattr(t, "montant_usd", 0.0) or 0.0))
+        if montant <= 0:
+            continue
+        cree = None
+        brut_t = getattr(t, "cree_le", None)
+        if brut_t:
+            cree = pd.to_datetime(brut_t, errors="coerce", utc=True)
+        if cree is not None and pd.notna(cree) and cree_ref is not None and pd.notna(cree_ref):
+            apres = cree > cree_ref
+        else:
+            jour = getattr(t, "date", None)
+            apres = bool(jour and jour > derniere)
+        if not apres:
+            continue
+        signe = 1.0 if getattr(t, "est_achat", False) else -1.0
+        total += signe * montant
+    return round(total, 2)
+
