+def _ajouter_flux_instruments(flux: list[float], montant_final: float) -> list[float]:
+    """Impute les achats/ventes de titres à la DERNIÈRE période comparée.
+
+    Le calcul journalier compare la référence et la valeur du moment, qui
+    portent souvent la même date : aucun fenêtrage par date ne peut y placer
+    l'opération. On l'ajoute donc explicitement au dernier flux.
+    """
+    if not flux or not montant_final:
+        return flux
+    sortie = [float(f) for f in flux]
+    sortie[-1] = round(sortie[-1] + float(montant_final), 2)
+    return sortie
+
+
 def twr_portefeuille(ctx: "Contexte") -> float | None:
     """TWR depuis le premier snapshot, corrigé des apports et retraits (en $)."""
     df, valeurs, flux = serie_performance(ctx)
     if len(valeurs) < 2:
         return None
+    flux = _ajouter_flux_instruments(flux, flux_instruments_final_usd(ctx))
     return metrics.twr_depuis(valeurs, flux)
 
 
